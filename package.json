{
  "name": "evo-racer-ai-lab",
  "version": "1.1.1",
  "private": true,
  "description": "Watch AI cars learn to race by evolution, fully offline on Windows.",
  "author": "Efe Erim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EfeErim/evo-racer-ai-lab.git"
  },
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "tsc -b --pretty false && vite build",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "check:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-doc-links.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:python": ".venv\\Scripts\\python -m ruff format python",
    "format:python:check": ".venv\\Scripts\\python -m ruff format --check python",
    "lint": "eslint . --max-warnings 0",
    "lint:python": ".venv\\Scripts\\python -m ruff check python",
    "test": "vitest run tests",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e.ps1",
    "test:learning": ".venv\\Scripts\\python python/tools/learning_benchmark.py --fixture docs/experiments/data/learning-benchmark-v2.json",
    "test:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-release.ps1",
    "test:python": ".venv\\Scripts\\python -m pytest",
    "typecheck": "tsc -b --pretty false",
    "typecheck:python": ".venv\\Scripts\\python -m mypy python/src python/tests python/tools"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "11.0.1",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
