{
  "name": "evo-racer-ai-lab",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "tsc -b --pretty false && vite build",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "check:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-doc-links.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m evo_racer.service",
    "format": "prettier --write .github/workflows/ci.yml src tests e2e index.html package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js README.md \"docs/*.md\" \"docs/experiments/*.md\" \"docs/testing/*.md\"",
    "format:check": "prettier --check .github/workflows/ci.yml src tests e2e index.html package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js README.md \"docs/*.md\" \"docs/experiments/*.md\" \"docs/testing/*.md\"",
    "format:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m ruff format python",
    "format:python:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m ruff format --check python",
    "lint": "eslint . --max-warnings 0",
    "lint:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m ruff check python",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "sign:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-release.ps1",
    "test": "vitest run tests",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e.ps1",
    "test:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-gate.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-public-release.ps1",
    "test:learning": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 python/tools/learning_benchmark.py --fixture contracts/learning-benchmark-v2.json",
    "test:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-release.ps1",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sandbox.ps1",
    "test:thorough": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-thorough.ps1",
    "test:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m pytest",
    "typecheck": "tsc -b --pretty false",
    "typecheck:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-python.ps1 -m mypy python/src python/tests python/tools"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "11.0.1",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
